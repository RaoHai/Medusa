; Engine configuration file.
; Godot 4.3+

config_version=5

[application]

config/name="Vesper Harbor - Isometric Detective Demo"
config/description="等轴透视视角、油画风格的侦探 RPG Demo（灵感来自极乐迪斯科式的叙事与技能检定）。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/include_text_server_data=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="interact"
3d_physics/layer_3="player"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.06, 0.07, 0.08, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
